# App
SECRET_KEY=change-me-to-a-random-string
DATABASE_URL=sqlite+aiosqlite:///data/app.db
# Public URL friends open (invite links are https://YOUR_APP_URL/join/CODE)
APP_URL=https://library.example.com

# Android APK updates (GitHub Releases â€” latest .apk asset)
# ANDROID_APK_GITHUB_REPO=brutaliccus/Library
# GITHUB_TOKEN=  # optional; raises API rate limit for update checks

# Host paths mounted into the app container (docker-compose.yml)
# AUDIOBOOK_HOST_DIR=./media/audiobooks
# MUST match Kavita's library folder (e.g. /mnt/eBooks) or downloads won't appear in My Library â†’ Ebooks
# EBOOK_HOST_DIR=/mnt/eBooks
# OPENLIBRARY_HOST_DIR=./media/openlibrary
# PUID/PGID apply to the app container AND linuxserver sidecars (Prowlarr/Jackett).
# App must share UID with LibraForge (default 1000) or M4B/Folder Forge hits Permission denied on .unorganized.
# PUID=1000
# PGID=1000
# TZ=UTC

# Prowlarr
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=your-prowlarr-api-key

# Indexer cache scraper (optional â€” defaults shown)
# SCRAPER_ENABLED=true
# SCRAPER_INTERVAL_SECONDS=30
# SCRAPER_QUERIES_PER_JOB=8
# SCRAPER_QUERY_DELAY_SECONDS=2
# SCRAPER_PROWLARR_TIMEOUT=120
# SCRAPER_DEBRID_INTERVAL_HOURS=1
# SCRAPER_DEBRID_BATCH_SIZE=300
# SCRAPER_MATCH_BATCH_SIZE=200
# SCRAPER_RSS_EVERY_N_JOBS=1

# AudioBook Bay — RSS-only is the Admin default (Cache → Tuning). Env seed:
# ABB_RSS_ONLY=true
# ABB_AUTHOR_CRAWL_ENABLED=false
# ABB_DEEP_SEARCH_ENABLED=false
# ABB_LIVE_SEARCH_ENABLED=false
# Live Jackett ABB download search stays on even when RSS-only.
# Background RSS pulls ABB recent listings via FlareSolverr + ABB_PROXY_URL (VPN).

# Mullvad WireGuard â€” HTTP proxy for ABB only (gluetun:8888).
# Jackett/Knaben stay on LAN. Prefer Admin -> Integrations to register WG keys.
# WIREGUARD_PRIVATE_KEY=
# WIREGUARD_ADDRESSES=10.x.x.x/32
# MULLVAD_ACCOUNT_NUMBER=
# MULLVAD_COUNTRY=USA
# ABB_PROXY_URL=http://gluetun:8888

# Real-Debrid  (get from https://real-debrid.com/apitoken)
REAL_DEBRID_API_TOKEN=your-real-debrid-api-token

# Torbox (optional second debrid service â€” get from https://torbox.app/settings)
# TORBOX_API_TOKEN=your-torbox-api-token

# Audiobookshelf
ABS_URL=http://localhost:13378
ABS_API_KEY=your-audiobookshelf-api-key
ABS_LIBRARY_ID=your-library-id

# LibraForge sibling stack (Metadata / M4B / Folder Forge via HTTP). Not in this compose.
# Public URL opens in Admin Health / Manual Review deep-links; internal URL for API + health.
# LIBRAFORGE_URL=https://forge.library.freiverse.com
# LIBRAFORGE_INTERNAL_URL=http://172.17.0.1:5056
# LIBRAFORGE_PIPELINE_ENABLED=true
# Auto-apply threshold: scores ≥ this value always get full tag overwrite + replace-cover
# (POST /api/runs: apply=true, write_mode=overwrite, replace_cover=true — never smart /
# cover-if-missing only). Score means match identity, not that torrent tags were good.
# LIBRAFORGE_MIN_SCORE=0.70
# LIBRAFORGE_NAMING_TEMPLATE={author}/{series} [{edition}]/{title}/{filename}
# Per-run m4b-tool workers on Pi (Library Site also queues cross-request M4B to 1).
# LIBRAFORGE_M4B_JOBS=1
# Heavy M4B: prefer Pi; Windows LibraForge :5057 is a manual fallback only.

# DIY ebook organizer (no LibraForge): land in /ebooks/unorganized, identify metadata,
# embed OPF via ebook-meta, move to Author/Series/Title, Kavita scan.
# Kavita library must exclude the folder named ``unorganized`` (already configured on Pi).
# EBOOK_PIPELINE_ENABLED=true
# Auto-organize threshold (same idea as LIBRAFORGE_MIN_SCORE). Below → quarantine.
# EBOOK_MIN_SCORE=0.70

# Kavita (ebooks / PDF+EPUB reader)
# KAVITA_URL=http://localhost:5000
# KAVITA_API_KEY=your-kavita-api-key
# KAVITA_LIBRARY_ID=0

# Catalog APIs â€” preferred: Admin â†’ Config (DB). Env is fallback.
# NYT_API_KEY=your-nyt-api-key
# ISBNDB_API_KEY=your-isbndb-rest-key
# HARDCOVER_API_KEY=Bearer_or_raw_token
# OpenRouter LLM assist (Metadata Forge quarantine recovery). Prefer Admin → Integrations.
# OPENROUTER_ENABLED=false
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_CONFIDENCE_THRESHOLD=0.85
# GOOGLE_BOOKS_API_KEY=
# AA_ACCOUNT_ID=   # Anna's Archive membership cookie (optional)

# Jackett (usually auto-synced by deploy/install scripts)
# JACKETT_URL=http://audiobook-jackett:9117
# JACKETT_API_KEY=
# FLARESOLVERR_URL=http://flaresolverr:8191

# Push notifications (generate with: python scripts/generate_vapid.py)
# VAPID_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# VAPID_PUBLIC_KEY=base64url...

# Storage / Paths (also Admin → Config → Storage / Paths; DB overrides env)
# Container library roots — must match docker-compose volume targets.
AUDIOBOOK_DIR=/audiobooks
EBOOK_DIR=/ebooks
# Staging folder names under those roots (pipelines land downloads here).
# AUDIOBOOK_STAGING_DIRNAME=.unorganized
# AUDIOBOOK_STAGING_LEGACY_DIRNAME=_unorganized
# EBOOK_STAGING_DIRNAME=unorganized
# Open Library catalog (optional local metadata DB)
# OL_CATALOG_DB_PATH=/app/data/ol_catalog.db
# OL_DUMPS_DIR=/openlibrary/dumps
# Host bind mounts stay compose-only (see AUDIOBOOK_HOST_DIR / EBOOK_HOST_DIR above).
