         self.assertLess(score, 0.70, f"score={score}")
 
 
+class MissingDurationIdentityFloorTests(unittest.TestCase):
+    """Title + author + agreeing book number must auto-apply even when local
+    duration was never probed (common for some prebuilt .m4b imports).
+    """
+
+    def test_honeybites_without_duration_clears_min_score(self):
+        clues = {
+            "title": "Honeybites, Book 2",
+            "raw_title": "Honeybites, Book 2",
+            "series": "",
+            "author": "I.S. Belle",
+            "narrator": "",
+            "book_number": "2",
+            "book_number_source": "title",
+        }
+        p = product(
+            asin="B0HONEYBIT2",
+            title="Honeybites",
+            series="Honeybloods",
+            sequence="2",
+            authors=("I.S. Belle",),
+            narrators=("Jen Jayden",),
+            minutes=274.0,
+        )
+        # Pre-fix baseline without the unknown-duration floor was ~0.46.
+        score = FIXER.score_product_for_metadata(clues, p, None)
+        self.assertGreaterEqual(score, 0.70, f"score={score}")
+        self.assertGreaterEqual(
+            FIXER.score_product_for_metadata(clues, p, 274.0),
+            0.90,
+        )
+
+    def test_missing_duration_still_rejects_wrong_book_number(self):
+        clues = {
+            "title": "Honeybites, Book 2",
+            "raw_title": "Honeybites, Book 2",
+            "series": "",
+            "author": "I.S. Belle",
+            "narrator": "",
+            "book_number": "2",
+            "book_number_source": "title",
+        }
+        p = product(
+            asin="B0HONEYBLO1",
+            title="Honeybloods",
+            series="Honeybloods",
+            sequence="1",
+            authors=("I.S. Belle",),
+            narrators=("Jen Jayden",),
+            minutes=240.0,
+        )
+        score = FIXER.score_product_for_metadata(clues, p, None)
+        self.assertLess(score, 0.70, f"score={score}")
+
+
 if __name__ == "__main__":
     unittest.main()
