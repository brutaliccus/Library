diff --git a/app/fixer/scoring.py b/app/fixer/scoring.py
index c0dd1f1..e6feb15 100644
--- a/app/fixer/scoring.py
+++ b/app/fixer/scoring.py
@@ -1102,6 +1102,20 @@ def score_product_for_metadata(
     if series_match and (author_good or narrator_good):
         score = max(score, 0.72)
 
+    # Missing local duration (ffprobe miss / unscanned m4b) must not block a
+    # clear identity. Without a duration signal, title+author+sequence tops out
+    # near ~0.46 and never clears min_score ΓÇö e.g. Honeybites / I.S. Belle with
+    # empty runtime vs Audible Honeybloods #2. Require agreeing book numbers so
+    # same-author adjacent volumes stay rejected.
+    if (
+        duration_result["status"] == "unknown"
+        and title_score >= 0.85
+        and author_good
+        and sequence_match
+        and not _number_unconfirmed
+    ):
+        score = max(score, 0.72)
+
     # Perfect confidence path:
     # duration <= 3% difference + title match + author match
     # should be considered extremely reliable.
diff --git a/app/tests/test_fixer_v5_scoring.py b/app/tests/test_fixer_v5_scoring.py
index 887d94d..1c9c9da 100644
--- a/app/tests/test_fixer_v5_scoring.py
